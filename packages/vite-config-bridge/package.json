  "keywords": [
    "react-native",
    "vifx",
    "vite"
  ],
  "homepage": "https://github.com/Salnika/vifx/tree/master/packages/vite-config-bridge#readme",
  "bugs": "https://github.com/Salnika/vifx/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salnika/vifx.git",
    "directory": "packages/vite-config-bridge"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
