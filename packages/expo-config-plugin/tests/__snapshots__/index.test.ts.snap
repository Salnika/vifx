exports[`app/build.gradle without a react {} block gains a marker-wrapped block 1`] = `
"apply plugin: "com.android.application"

android {
    namespace 'com.example.app'
    defaultConfig {
        applicationId 'com.example.app'
        versionCode 1
        versionName "1.0.0"
    }
}

dependencies {
    implementation("com.facebook.react:react-android")
}
// @generated begin vifx-bundle-command - expo prebuild (DO NOT MODIFY) sync-613d361523aa104e4c4f83edf90044c0ab1b6f0e
