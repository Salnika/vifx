{
  "name": "@vifx/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "cli": "./dist/bin.mjs",
    "vifx": "./dist/bin.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./bin": "./dist/bin.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "prepublishOnly": "vp run build",
    "vifx": "node ./bin/vifx.mjs"
  },
  "dependencies": {
    "@vifx/codemods": "workspace:*",
    "@vifx/compat": "workspace:*",
    "@vifx/compat-runner": "workspace:*",
    "@vifx/config": "workspace:*",
    "@vifx/errors": "workspace:*",
    "@vifx/expo-export": "workspace:*",
    "@vifx/hermes-tools": "workspace:*",
    "@vifx/metro-inspect": "workspace:*",
    "@vifx/native-artifacts": "workspace:*",
    "@vifx/types": "workspace:*",
    "@vifx/vite-plugin-expo": "workspace:*",
    "@vifx/vite-plugin-react-native": "workspace:*",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
