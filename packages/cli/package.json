{
  "name": "@vifx/cli",
  "version": "0.1.0",
  "description": "The vifx command line: Expo Go and React Native dev servers, release bundles, doctor and migration tools, without Metro.",
  "keywords": [
    "bundler",
    "cli",
    "expo",
    "fast-refresh",
    "metro",
    "react-native",
    "rolldown",
    "vite"
  ],
  "homepage": "https://github.com/Salnika/vifx#readme",
  "bugs": "https://github.com/Salnika/vifx/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salnika/vifx.git",
    "directory": "packages/cli"
  },
  "bin": {
    "vifx": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./bin": "./dist/bin.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "vifx": "node ./bin/vifx.mjs"
  },
  "dependencies": {
    "@vifx/asset-registry": "workspace:*",
    "@vifx/codemods": "workspace:*",
    "@vifx/compat": "workspace:*",
    "@vifx/compat-runner": "workspace:*",
    "@vifx/config": "workspace:*",
    "@vifx/core": "workspace:*",
    "@vifx/errors": "workspace:*",
    "@vifx/expo-export": "workspace:*",
    "@vifx/hermes-tools": "workspace:*",
    "@vifx/logger": "workspace:*",
    "@vifx/metro-inspect": "workspace:*",
    "@vifx/source-map-tools": "workspace:*",
    "@vifx/types": "workspace:*",
    "@vifx/vite-plugin-expo": "workspace:*",
    "@vifx/vite-plugin-react-native": "workspace:*",
    "@voidzero-dev/vite-plus-core": "catalog:",
    "qrcode-terminal": "^0.12.0",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
