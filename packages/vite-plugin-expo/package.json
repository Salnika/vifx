  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salnika/vifx.git",
    "directory": "packages/vite-plugin-expo"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
