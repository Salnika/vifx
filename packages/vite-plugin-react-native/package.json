    "@vifx/source-map-tools": "workspace:*",
    "@vifx/transform-cache": "workspace:*",
    "@vifx/types": "workspace:*",
    "@vifx/vite-config-bridge": "workspace:*",
    "@voidzero-dev/vite-plus-core": "catalog:",
    "magic-string": "^1.4.5",
    "react-refresh": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
