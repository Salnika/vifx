{
  "name": "@vifx/vite-plugin-react-native",
  "version": "0.0.0",
  "description": "Vite plugin that bundles React Native apps: platform resolution, Babel and Oxc transforms, assets, Hermes and Fast Refresh.",
  "keywords": [
    "fast-refresh",
    "hermes",
    "metro",
    "react-native",
    "rolldown",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/Salnika/vifx/tree/master/packages/vite-plugin-react-native#readme",
  "bugs": "https://github.com/Salnika/vifx/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salnika/vifx.git",
    "directory": "packages/vite-plugin-react-native"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
