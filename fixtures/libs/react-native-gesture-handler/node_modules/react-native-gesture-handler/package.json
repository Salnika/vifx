{
  "name": "react-native-gesture-handler",
  "version": "2.20.2",
  "description": "Synthetic replica of react-native-gesture-handler packaging: an exports map plus a react-native field pointing at TypeScript sources that reach into a native module via the React Native default export.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "react-native": "src/index.ts",
  "types": "lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/index.ts",
    "./lib/module/index.js"
  ],
  "files": [
    "lib",
    "src"
  ],
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  }
}
