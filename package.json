{
  "name": "vifx",
  "version": "0.0.0",
  "private": true,
  "description": "Vite + Rolldown bundling for React Native and Expo, without Metro.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salnika/vifx.git"
  },
  "type": "module",
  "scripts": {
    "bench:expo": "node ./scripts/bench/expo-vs-vifx.mjs",
    "build": "vp run --filter \"./packages/*\" build",
    "changeset": "changeset",
    "check": "vp check",
    "cli:link": "node ./scripts/bootstrap-local-cli.mjs",
    "compat:metro": "pnpm --filter @vifx/cli vifx compat run --adapter metro",
    "compat:vifx": "pnpm --filter @vifx/cli vifx compat run --adapter vifx",
    "docs:build": "pnpm --filter docs run build",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:support-matrix": "node ./scripts/generate-support-matrix.mjs",
    "docs:support-matrix:check": "node ./scripts/generate-support-matrix.mjs --check",
    "lint": "vp lint",
    "playground:expo": "pnpm --filter playground-expo run validate",
    "playground:rn-bare": "pnpm --filter playground-rn-bare run validate",
    "playground:universal": "pnpm --filter playground-universal run validate",
    "playground:validate": "pnpm playground:rn-bare && pnpm playground:expo && pnpm playground:universal",
    "prepare": "vp config",
    "ready": "vp run build && vp check && pnpm typecheck && vp run test && pnpm playground:validate",
    "release": "changeset publish",
    "test": "vp run --filter \"./packages/*\" test",
    "typecheck": "pnpm -r exec tsrs --noEmit",
    "version-packages": "changeset version",
    "vifx": "pnpm --filter @vifx/cli vifx"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
