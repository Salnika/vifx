{
  "name": "playground-rn-bare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "vifx:doctor": "vifx doctor .",
    "vifx:inspect": "vifx inspect .",
    "vifx:build:ios": "vifx build . --platform ios",
    "vifx:build:android": "vifx build . --platform android",
    "vite:build:ios": "VIFX_PLATFORM=ios vp build --config vite.config.vifx.ts",
    "validate": "pnpm run vifx:doctor && pnpm run vifx:inspect && pnpm run vifx:build:ios && pnpm run vifx:build:android && pnpm run vite:build:ios"
  },
  "dependencies": {
    "react-native": "file:./vendor/react-native",
    "react-native-web": "file:./vendor/react-native-web"
  },
  "devDependencies": {
    "@vifx/cli": "workspace:*",
    "@vifx/config": "workspace:*",
    "@vifx/vite-plugin-react-native": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.1.2"
}
